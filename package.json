{
  "name": "organivaa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names NEXT,FLASK --prefix-colors cyan,green \"npm:dev:web\" \"npm:backend:dev\"",
    "dev:web": "next dev",
    "backend:dev": "npm run backend:seed && npm run backend",
    "backend": "python -m backend.run",
    "backend:seed": "python -m flask --app backend.run seed",
    "backend:test": "python -m pytest backend/tests",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
