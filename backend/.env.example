FLASK_ENV=development
DATABASE_URL=sqlite:///organivaa.db
SECRET_KEY=replace-with-at-least-32-random-characters
SERVICE_TOKEN=organivaa-local-service-token
ADMIN_EMAIL=admin@organivaa.local
ADMIN_PASSWORD=change-me-before-production
PORT=5000
PAYMENT_PROVIDER=sandbox
SHIPPING_PROVIDER=sandbox
# Replace sandbox with a reviewed provider adapter and set its credentials before launch.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_PINCODE=
MAX_UPLOAD_BYTES=10485760
